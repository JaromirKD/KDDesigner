  "triggers": [
    {
      "id": 10001,
      "name": "== START-UP",
      "type": "comment",
      "color": "green",
      "actions": [],
      "conditions": [],
      "notes": "Tuesday to Sunday. Order matters: power first, then PCs, then projectors; and the other way round at night, with time for the projectors to cool down."
    },
    {
      "id": 1,
      "name": "Startup",
      "type": "startup",
      "color": "green",
      "actions": [
        "if mode Building is Open then scene \"Lobby open\" fade 5 else scene \"Lobby night\" fade 5",
        "panel lbl_building text Building: {mode.Building}"
      ],
      "conditions": []
    },
    {
      "id": 2,
      "name": "Start building 08:30",
      "type": "time",
      "at": "08:30:00",
      "days": [
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ],
      "color": "green",
      "actions": [
        "mode Building Starting"
      ],
      "conditions": [
        "calendar Closed inactive",
        "mode Building is Off"
      ]
    },
    {
      "id": 3,
      "name": "Start-up report",
      "type": "manual",
      "color": "green",
      "actions": [
        "var problems = \"\"",
        "if device \"PC Entrance\" is offline then var problems = \"{problems} [PC Entrance]\"",
        "if device \"PC Ticketing\" is offline then var problems = \"{problems} [PC Ticketing]\"",
        "if device \"PC Shop\" is offline then var problems = \"{problems} [PC Shop]\"",
        "if device \"PC Room 1.1\" is offline then var problems = \"{problems} [PC Room 1.1]\"",
        "if device \"PC Room 1.2\" is offline then var problems = \"{problems} [PC Room 1.2]\"",
        "if device \"PC Room 1.3\" is offline then var problems = \"{problems} [PC Room 1.3]\"",
        "if device \"PC Room 2.1\" is offline then var problems = \"{problems} [PC Room 2.1]\"",
        "if device \"PC Room 2.2\" is offline then var problems = \"{problems} [PC Room 2.2]\"",
        "if device \"PC Room 2.3\" is offline then var problems = \"{problems} [PC Room 2.3]\"",
        "if device \"PJ Entrance\" is offline then var problems = \"{problems} [PJ Entrance]\"",
        "if device \"PJ Room 1.1\" is offline then var problems = \"{problems} [PJ Room 1.1]\"",
        "if device \"PJ Room 1.2\" is offline then var problems = \"{problems} [PJ Room 1.2]\"",
        "if device \"PJ Room 2.1\" is offline then var problems = \"{problems} [PJ Room 2.1]\"",
        "if device \"PJ Room 2.2\" is offline then var problems = \"{problems} [PJ Room 2.2]\"",
        "if device \"PJ Room 2.3\" is offline then var problems = \"{problems} [PJ Room 2.3]\"",
        "if var problems = \"\" then log Start-up OK: all devices online else email tech@museum.example \"Start-up: devices offline\" Not answering:{problems}",
        "if var problems = \"\" then panel lbl_report text All devices online else panel lbl_report text Offline: {problems}"
      ],
      "conditions": [],
      "notes": "Every PC and projector is checked once; one email lists all that are missing."
    },
    {
      "id": 4,
      "name": "Stop building 17:30",
      "type": "time",
      "at": "17:30:00",
      "color": "green",
      "actions": [
        "mode Building Stopping"
      ],
      "conditions": [
        "mode Building is Open"
      ]
    },
    {
      "id": 5,
      "name": "Weekly reboot (Monday 07:00)",
      "type": "time",
      "at": "07:00:00",
      "days": [
        "mon"
      ],
      "color": "green",
      "actions": [
        "netio pdus output all on",
        "sleep 60",
        "pc all wake",
        "sleep 300",
        "pc all reboot",
        "sleep 300",
        "pc all shutdown",
        "sleep 120",
        "netio pdus output all off"
      ],
      "conditions": [],
      "notes": "Monday the museum is closed: the PCs get their Windows updates and a fresh start."
    },
    {
