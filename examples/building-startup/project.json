  "modes": [
    {
      "name": "Building",
      "states": [
        "Off",
        "Starting",
        "Open",
        "Event",
        "Stopping"
      ],
      "var": "building_state",
      "stateInfo": {
        "Off": {
          "color": "#616161",
          "icon": "🌙"
        },
        "Starting": {
          "color": "#d29922",
          "icon": "⏳",
          "enter": [
            "netio pdus output all on",
            "log Racks powered",
            "sleep 60",
            "pc floor0 wake",
            "pc floor1 wake",
            "pc floor2 wake",
            "sleep 30",
            "projector all on",
            "release all fade 20",
            "scene \"Lobby open\" fade 20",
            "sleep 180",
            "monitor check",
            "sleep 15",
            "fire trigger \"Start-up report\"",
            "mode Building Open"
          ]
        },
        "Open": {
          "color": "#3fb950",
          "icon": "🟢"
        },
        "Event": {
          "color": "#8957e5",
          "icon": "🥂"
        },
        "Stopping": {
          "color": "#ff9f43",
          "icon": "⏬",
          "enter": [
            "projector all off",
            "pc all shutdown",
            "release all fade 60",
            "scene \"Lobby night\" fade 60",
            "# projectors cool down and Windows shuts down before the power goes",
            "sleep 300",
            "netio pdus output all off",
            "mode Building Off"
          ]
        }
      }
    }
  ],
