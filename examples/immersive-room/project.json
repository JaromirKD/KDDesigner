      "name": "== START & SAFETY",
      "type": "comment",
      "color": "red",
      "actions": [],
      "conditions": [],
      "notes": "Fire alarm and door contact come in on the Kiss-Box (slot 1), the start button's LED goes out on slot 2."
    },
    {
      "id": 1,
      "name": "Startup",
      "type": "startup",
      "color": "red",
      "actions": [
        "mode Room Idle",
        "fire trigger \"Start inloop\" after 5"
      ],
      "conditions": []
    },
    {
      "id": 2,
      "name": "Fire alarm",
      "type": "variable",
      "variable": "fire_alarm",
      "value": "on",
      "color": "red",
      "actions": [
        "mode Room Emergency",
        "send osc mediaserver /stop",
        "send osc qlab /panic",
        "email tech@museum.example \"Fire alarm\" Immersive room stopped by the fire alarm"
      ],
      "conditions": [],
      "notes": "Contact from the fire alarm panel on Kiss-Box input 1.3. The Emergency state puts all light on."
    },
    {
      "id": 3,
      "name": "Fire alarm over",
      "type": "variable",
      "variable": "fire_alarm",
      "value": "off",
      "color": "red",
      "actions": [
        "mode Room Idle",
        "fire trigger \"Start inloop\""
      ],
      "conditions": [
        "mode Room is Emergency"
      ]
    },
    {
      "id": 10002,
      "name": "== SHOW CYCLE",
      "type": "comment",
      "color": "purple",
      "actions": [],
      "conditions": [],
      "notes": "Visitors press the start button, or the show starts by itself every 15 minutes during opening hours."
    },
    {
      "id": 4,
      "name": "Start inloop",
      "type": "manual",
      "color": "purple",
      "actions": [
        "start timeline \"Inloop\"",
        "send osc mediaserver /cue/inloop/start",
        "kissbox io 2.1 on",
        "panel \"Start show\" reset",
        "panel lbl_status text Waiting for visitors"
      ],
      "conditions": [
        "mode Room not Emergency"
      ]
    },
    {
      "id": 5,
      "name": "Start show",
      "type": "manual",
      "color": "purple",
      "actions": [
        "mode Room Show",
        "kissbox io 2.1 off",
        "start timeline Show",
        "var shows_today ++",
        "var shows_total ++",
        "panel \"Start show\" text RUNNING",
        "panel lbl_status text Show is running"
      ],
      "conditions": [
        "mode Room is Idle",
        "timeline Show stopped"
      ],
      "whileRunning": "ignore"
    },
    {
      "id": 6,
      "name": "Show: start media",
      "type": "manual",
      "color": "purple",
      "actions": [
        "send osc mediaserver /cue/show/start",
        "send osc qlab /cue/show/go"
      ],
      "conditions": [],
      "notes": "Fired by the ◆ cue at 5 s on the Show timeline, after the room has gone dark."
    },
    {
      "id": 7,
      "name": "Show finished",
      "type": "timeline_end",
      "timeline": 1,
      "color": "purple",
      "actions": [
        "mode Room Idle",
        "fire trigger \"Start inloop\"",
        "log Show {shows_today} of today finished"
      ],
      "conditions": []
    },
    {
      "id": 8,
      "name": "Stop show",
      "type": "manual",
      "color": "purple",
      "actions": [
        "stop timeline Show fade 3",
        "send osc mediaserver /stop",
        "send osc qlab /cue/show/stop",
        "mode Room Idle",
        "fire trigger \"Start inloop\" after 3"
      ],
      "conditions": []
    },
