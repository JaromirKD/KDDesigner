        "Idle": {
          "color": "#3a7bd5",
          "icon": "⏸"
        },
        "Show": {
          "color": "#2e7d32",
          "icon": "▶"
        },
        "Maintenance": {
          "color": "#f9a825",
          "icon": "🔧",
          "enter": [
            "release all fade 2",
            "scene \"Work light\" fade 2"
          ],
          "leave": [
            "release scene \"Work light\" fade 2",
            "fire trigger \"Start inloop\""
          ]
        },
        "Emergency": {
          "color": "#b71c1c",
          "icon": "⚠",
          "enter": [
            "release all fade 0",
            "set 1.1-4 255",
            "set 1.60-61 255",
            "panel lbl_status text FIRE ALARM",
            "panel lbl_status flash red"
          ],
          "leave": [
            "clear overrides",
            "panel lbl_status reset"
          ]
        }
      }
    }
  ],
