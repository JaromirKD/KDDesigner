    {
      "id": 9,
      "name": "Play station",
      "type": "manual",
      "color": "purple",
      "actions": [
        "cancel trigger \"Back to attract\"",
        "mode Exhibit Playing",
        "release all fade 1",
        "scene {station} fade 1",
        "kissbox buttons 2 all 0 0 0 0 0 0 0 0",
        "kissbox buttons 2.{station} on",
        "brightsign screen play Video station{station}.mp4",
        "log Station {station} pressed",
        "fire trigger \"Back to attract\" after 75"
      ],
      "conditions": [],
      "notes": "Videos are max. 70 s; after 75 s the exhibit goes back to attract by itself. Name the files station1.mp4 … station6.mp4 on the BrightSign."
    },
    {
      "id": 10,
      "name": "Video ended (BrightSign)",
      "type": "variable",
      "variable": "video_state",
      "value": "ended",
      "color": "purple",
      "actions": [
        "fire trigger \"Back to attract\""
      ],
      "conditions": [
        "mode Exhibit is Playing"
      ],
      "notes": "With the KD plugin: give the presentation a Send Plugin Message \"zone Video ended\" (plugin kdlink) when a station video ends; zone 1 follows variable video_state."
