      "stateInfo": {
        "Closed": {
          "color": "#616161",
          "icon": "🌙",
          "enter": [
            "release all fade 30",
            "scene \"Lobby night\" fade 30",
            "brightsign screens send night"
          ]
        },
        "Open": {
          "color": "#3fb950",
          "icon": "🟢",
          "enter": [
            "release all fade 5",
            "scene \"Lobby day\" fade 10",
            "scene \"Corridor idle\" fade 10",
            "scene \"Cinema walk-in\" fade 10",
            "brightsign screens send day"
          ]
        },
        "Emergency": {
          "color": "#b71c1c",
          "icon": "⚠",
          "enter": [
            "release all fade 0",
            "scene Emergency fade 0",
            "brightsign screens send emergency",
            "panel lbl_museum flash red"
          ],
          "leave": [
            "panel lbl_museum reset"
          ]
        }
      }
    }
  ],
