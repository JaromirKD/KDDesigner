  "triggers": [
    {
      "id": 10001,
      "name": "== MUSEUM",
      "type": "comment",
      "color": "red",
      "actions": [],
      "conditions": [],
      "notes": "The Museum mode group switches every player at once through the device group \"screens\" (a UDP command, so it works with and without the KD plugin)."
    },
    {
      "id": 1,
      "name": "Startup",
      "type": "startup",
      "color": "red",
      "actions": [
        "if mode Museum is Open then mode Museum Open else mode Museum Closed"
      ],
      "conditions": []
    },
    {
      "id": 2,
      "name": "Open 10:00",
      "type": "time",
      "at": "10:00:00",
      "color": "red",
      "actions": [
        "mode Museum Open"
      ],
      "conditions": [
        "calendar Closed inactive"
      ]
    },
    {
      "id": 3,
      "name": "Close 17:00",
      "type": "time",
      "at": "17:00:00",
      "color": "red",
      "actions": [
        "mode Museum Closed"
      ],
      "conditions": []
    },
    {
      "id": 4,
      "name": "Mode -> panel",
      "type": "mode",
      "group": "Museum",
      "color": "red",
      "actions": [
        "panel lbl_museum text Museum: {mode}"
      ],
      "conditions": []
    },
    {
      "id": 5,
      "name": "Weekly reboot (Monday 07:00)",
      "type": "time",
      "at": "07:00:00",
      "days": [
        "mon"
      ],
      "color": "red",
      "actions": [
        "brightsign screens reboot",
        "log All players rebooted"
      ],
      "conditions": [],
      "notes": "A fresh start once a week. Through the KD plugin where it is on, else through the DWS."
    },
    {
      "id": 6,
      "name": "Player offline",
      "type": "device",
      "device": "",
      "state": "offline",
      "color": "red",
      "actions": [
        "email tech@museum.example \"{device} offline\" BrightSign {device} stopped answering"
      ],
      "conditions": [
        "mode Museum is Open"
      ]
    },
    {
      "id": 10002,
      "name": "== 1 LOBBY - plain UDP",
      "type": "comment",
      "color": "orange",
      "actions": [],
      "conditions": [],
      "notes": "No plugin: the presentation has UDP input events \"day\", \"night\" and \"emergency\", and sends \"playing <state>\" to the controller on every state. That arrives as Player says (linked to lobby_says)."
    },
    {
      "id": 7,
      "name": "Lobby says",
      "type": "variable",
      "variable": "lobby_says",
      "color": "orange",
      "actions": [
        "panel lbl_lobby text Lobby: {value}"
      ],
      "conditions": []
    },
    {
      "id": 10003,
      "name": "== 2 CINEMA - light follows the film",
      "type": "comment",
      "color": "purple",
      "actions": [],
      "conditions": [],
      "notes": "The UDP command \"video3\" starts the film. The KD plugin reports the Video zone (z1 -> cinema_video): the light follows what the player really does, also when someone starts the film on the player itself."
    },
    {
      "id": 8,
      "name": "Start film",
      "type": "manual",
      "color": "purple",
      "actions": [
        "brightsign cinema send video3",
        "log Film start asked"
      ],
      "conditions": [
        "var cinema_video != \"Video 3\""
      ]
    },
    {
      "id": 9,
      "name": "Film every hour",
      "type": "interval",
      "seconds": 3600,
      "color": "purple",
      "actions": [
        "fire trigger \"Start film\""
      ],
      "conditions": [
        "mode Museum is Open"
      ],
      "notes": "Plus the button on the panel."
    },
    {
      "id": 10,
      "name": "Film started",
      "type": "variable",
      "variable": "cinema_video",
      "value": "Video 3",
      "color": "purple",
      "actions": [
        "release scene \"Cinema walk-in\" fade 6",
        "start timeline \"Cinema film\"",
        "var films_today ++"
      ],
      "conditions": []
    },
    {
      "id": 11,
      "name": "Film ended",
      "type": "variable",
      "variable": "cinema_video",
      "color": "purple",
      "actions": [
        "stop timeline \"Cinema film\" fade 8",
