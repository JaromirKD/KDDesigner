{
  "name": "Museum gallery - opening hours",
  "settings": {
    "tzOffsetMin": 60,
    "udpPort": 4000,
    "sacnPriority": 100,
    "monitor": {
      "interval": 60,
      "timeout": 1000,
      "failures": 2
    },
    "time": {
      "ntp": "pool.ntp.org",
      "ntpEnabled": true,
      "dst": "eu"
    },
    "location": {
      "lat": 52.37,
      "lon": 4.9
    },
    "outputs": {
      "dmx": true,
      "artnet": true,
      "sacn": true,
      "dmxFps": 40,
      "artnetFps": 30,
      "sacnFps": 40,
      "artnetChangesOnly": true,
      "sacnChangesOnly": false
    }
  },
  "network": {
    "dhcp": false,
    "ip": "192.168.1.50",
    "mask": "255.255.255.0",
    "gateway": "192.168.1.1"
  },
  "modes": [
    {
      "name": "Museum",
      "states": [
        "Closed",
        "Cleaning",
        "Opening",
        "Open",
        "Event"
      ],
      "stateInfo": {
        "Closed": {
          "color": "#616161",
          "icon": "🌙",
          "enter": [
            "release all fade 30",
            "scene \"Night (security)\" fade 30",
            "projector all off",
            "brightsign \"Screen A\" send stop",
            "sleep 60",
            "pc all shutdown",
            "# projectors need a few minutes to cool down before the power goes",
            "sleep 240",
            "netio rack output 2 off"
          ]
        },
        "Cleaning": {
          "color": "#f9a825",
          "icon": "🧹",
          "enter": [
            "scene Cleaning fade 3"
          ],
          "leave": [
            "release scene Cleaning fade 5"
          ]
        },
        "Opening": {
          "color": "#d29922",
          "icon": "⏳",
          "enter": [
            "netio rack output 2 on",
            "release all fade 10",
            "sleep 20",
            "pc all wake",
            "projector all on",
            "wait until device \"PJ room A\" is online timeout 180",
            "projector all input 31",
            "mode Museum Open"
          ]
        },
        "Open": {
          "color": "#3fb950",
          "icon": "🟢",
          "enter": [
            "start timeline \"Opening hours\"",
            "brightsign \"Screen A\" send loop",
            "var days_open ++"
          ]
        },
        "Event": {
          "color": "#8957e5",
          "icon": "🥂",
          "enter": [
            "scene \"Evening event\" fade 20"
          ],
          "leave": [
            "release scene \"Evening event\" fade 10"
          ]
        }
      }
    }
  ],
  "universes": [
    {
      "id": 1,
      "name": "DMX 1",
      "dmxPort": 1,
      "artnet": 0,
