        "Lecture",
        "Film",
        "Break",
        "Cleaning"
      ],
      "stateInfo": {
        "Off": {
          "color": "#616161",
          "icon": "⏻",
          "enter": [
            "clear overrides",
            "release all fade 5",
            "projector \"Laser PJ\" off",
            "netio stage output 2 pulse 25",
            "knx building write \"Blinds hall\" off",
            "netio stage output 3 off"
          ]
        },
        "Walk-in": {
          "color": "#3a7bd5",
          "icon": "🚶",
          "enter": [
            "clear overrides",
            "release all fade 3",
            "scene \"Walk-in\" fade 3",
            "netio stage output 3 on",
            "projector \"Laser PJ\" on",
            "pc \"Lectern PC\" wake"
          ]
        },
        "Lecture": {
          "color": "#2e7d32",
          "icon": "🎤",
          "enter": [
            "clear overrides",
            "release all fade 3",
            "scene \"Lecture\" fade 3",
            "netio stage output 3 on",
            "projector \"Laser PJ\" on",
            "projector \"Laser PJ\" mute off",
            "netio stage output 1 pulse 25"
          ]
        },
        "Film": {
          "color": "#6a4c93",
          "icon": "🎬",
          "enter": [
            "clear overrides",
            "release all fade 3",
            "scene \"Film\" fade 3",
            "netio stage output 3 on",
            "projector \"Laser PJ\" on",
            "projector \"Laser PJ\" mute off",
            "netio stage output 1 pulse 25",
            "knx building write \"Blinds hall\" on"
          ]
        },
        "Break": {
          "color": "#d29922",
          "icon": "☕",
          "enter": [
            "clear overrides",
            "release all fade 3",
            "scene \"Break\" fade 3",
            "projector \"Laser PJ\" mute on",
            "knx building write \"Blinds hall\" off"
          ]
        },
        "Cleaning": {
          "color": "#f9a825",
          "icon": "🧹",
          "enter": [
            "clear overrides",
            "release all fade 3",
            "scene \"Cleaning\" fade 3",
            "projector \"Laser PJ\" off",
            "netio stage output 2 pulse 25"
          ]
        }
      }
    }
  ],
