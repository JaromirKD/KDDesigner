  ],
  "effects": [
   {
    "id": 1,
    "name": "XY ripple",
    "code": "// Rings rippling out from a point on the map, like a stone in water\nparam cx = 0.5 [0, 1]          // centre: 0 = left edge, 1 = right edge\nparam cy = 0.5 [0, 1]          // centre: 0 = top edge, 1 = bottom edge\nparam speed = 0.5 [0, 3]       // rings per second\nparam size = 3 [0.5, 10]       // rings from the centre to the edge\nparam color = #00c7be          // colour of the rings\nparam back = #000000           // colour between the rings\nd = sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy))\nk = pow(0.5 + 0.5 * sin((d * size - t * speed) * tau), 3)\nr = mix(back.r, color.r, k)\ng = mix(back.g, color.g, k)\nb = mix(back.b, color.b, k)"
   },
   {
    "id": 2,
    "name": "Chase",
    "code": "// One light running along the fixtures, in list order\nparam speed = 1 [0, 8]\nparam width = 0.25 [0.05, 1]\nparam color = #ffffff\npos = fract(t * speed / n)\nd = abs(fract(u - pos + 0.5) - 0.5) * n\nr, g, b = color\ndim = smoothstep(width * n, 0, d)"
   },
   {
    "id": 3,
    "name": "Breathe",
    "code": "// Slow fade up and down\nparam speed = 0.25 [0.02, 2]\nparam low = 0.1 [0, 1]\nparam color = #ffb347\nr, g, b = color\ndim = mix(low, 1, 0.5 - 0.5 * cos(t * speed * tau))"
   },
   {
    "id": 4,
    "name": "Candle",
    "code": "// Warm, gentle flicker\nparam color = #ff9329\nf = noise(t * 2.1 + i * 3.7) * 0.6 + noise(t * 7.3 + i) * 0.4\nr, g, b = color\ndim = 0.6 + f * 0.4"
   },
   {
    "id": 5,
    "name": "Chase 2",
    "code": "// One light running along the fixtures, in list order\nparam speed = 1 [0, 8]\nparam width = 0.25 [0.05, 1]\nparam color = #ffffff\npos = fract(t * speed / n)\nd = abs(fract(u - pos + 0.5) - 0.5) * n\nr, g, b = color\ndim = smoothstep(width * n, 0, d)"
   },
   {
    "id": 6,
    "name": "Fire",
    "code": "// Flickering flame, every fixture its own\nparam speed = 3 [0.5, 10]\nf = noise(t * speed + i * 17.3) * 0.7 + noise(t * speed * 2.7 + i * 5.1) * 0.3\nr = 1\ng = 0.25 + f * 0.35\nb = 0\ndim = 0.35 + f * 0.65"
   },
   {
    "id": 7,
    "name": "Sparkle",
    "code": "// Random short flashes on a coloured base\nparam rate = 6 [1, 30]\nparam chance = 0.08 [0, 0.5]\nparam base = #1a2a6c\nparam flash = #ffffff\nstep_t = floor(t * rate)\non = rand(step_t * 0.37 + i * 0.011) < chance\nr = on ? flash.r : base.r\ng = on ? flash.g : base.g\nb = on ? flash.b : base.b"
   },
   {
    "id": 8,
    "name": "Wave across the map",
    "code": "// Brightness wave moving left to right over the map\nparam speed = 0.3 [0, 2]\nparam size = 1.5 [0.2, 6]\nparam color = #00c7be\nr, g, b = color\ndim = 0.5 + 0.5 * sin((x * size - t * speed) * tau)"
   },
   {
    "id": 9,
    "name": "Police",
    "code": "// Red / blue alternating halves\nparam rate = 2 [0.5, 8]\nside = u < 0.5\nphase = sq(t * rate)\non = side ? phase : 1 - phase\nr = on\nb = 1 - on\ndim = pulse(t * rate * 4, 0.5) * 0.5 + 0.5"
   }
  ],
